rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function identidadPropia(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function cursoDisponible(curso, ciclo) {
      return curso is string && curso.matches('^[a-z0-9_-]{1,40}$')
        && ((curso == '4b' && ciclo == 2026)
          || get(/databases/$(database)/documents/ciclos/$(ciclo)/cursos/$(curso)).data.disponible == true);
    }
    function perfilValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['usuario','curso_predeterminado','ciclo','creada_en','actualizada_en'])
        && d.keys().hasOnly(['usuario','curso_predeterminado','ciclo','creada_en','actualizada_en'])
        && d.usuario is string && d.usuario.size() >= 3 && d.usuario.size() <= 30
        && d.ciclo is int && d.ciclo == 2026
        && cursoDisponible(d.curso_predeterminado, d.ciclo)
        && d.creada_en is timestamp && d.actualizada_en == request.time;
    }
    match /usuarios/{uid} {
      allow get: if identidadPropia(uid);
      allow list: if false;
      allow create: if identidadPropia(uid) && perfilValido()
        && request.resource.data.creada_en == request.time;
      allow update: if identidadPropia(uid) && perfilValido()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['curso_predeterminado','actualizada_en']);
      allow delete: if false;
    }

    // Notas privadas. El perfil y las reglas de NEXUS permanecen separados.
    match /usuarios/{uid}/libretas/{libreta}/notas/{nota} {
      function notaValida() {
        let d = request.resource.data;
        return d.keys().hasAll(['materia','valor','doble','borrada','curso','ciclo','actualizada_en'])
          && d.keys().hasOnly(['materia','valor','doble','borrada','curso','ciclo','actualizada_en'])
          && d.materia is string && d.materia.size() > 0 && d.materia.size() <= 100
          && d.valor is number && d.valor >= 0 && d.valor <= 10
          && d.doble is bool && d.borrada is bool
          && d.ciclo is int && d.ciclo >= 2026 && d.ciclo <= 2100
          && d.curso is string && d.curso.matches('^[a-z0-9_-]{1,40}$')
          && libreta == string(d.ciclo) + '_' + d.curso
          && nota.size() <= 500 && d.actualizada_en == request.time;
      }
      allow read: if identidadPropia(uid);
      allow create: if identidadPropia(uid) && notaValida();
      allow update: if identidadPropia(uid) && notaValida()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['borrada','actualizada_en'])
        && (resource.data.borrada == false || request.resource.data.borrada == true);
      allow delete: if false;
    }


    // El administrador asigna este documento desde Firebase Console.
    // Ningún cliente puede crearlo, editarlo ni listar permisos de otras cuentas.
    match /usuarios/{uid}/permisos/{permiso} {
      allow get: if identidadPropia(uid) && permiso == 'delegado';
      allow list, write: if false;
    }
    function esDelegado(curso,ciclo) {
      return request.auth != null && identidadPropia(request.auth.uid)
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/permisos/delegado)
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)/permisos/delegado).data.get('activo',false) == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)/permisos/delegado).data.get('curso','') == curso
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)/permisos/delegado).data.get('ciclo',0) == ciclo
        && cursoDisponible(curso,ciclo);
    }
    match /ciclos/{ciclo} {
      allow read: if true;
      allow write: if false;
      match /cursos/{curso} {
        allow read: if true;
        allow write: if false;
        match /avisos_semana/{dia} {
          allow read: if true;
          allow write: if false;
        }
        match /avisos/{aviso} {
          function baseValida() {
            let d = request.resource.data;
            return d.keys().hasAll(['datos','dia','curso','ciclo','autor_uid','creada_en','archivado'])
              && d.keys().hasOnly(['datos','dia','curso','ciclo','autor_uid','creada_en','archivado',
                'origen_documento','origen_indice'])
              && d.datos is map && d.curso == curso && d.ciclo == int(ciclo)
              && d.creada_en == request.time && d.archivado == false;
          }
          function nuevoValido() {
            let d = request.resource.data;
            let a = d.datos;
            return !('origen_documento' in d) && !('origen_indice' in d)
              && aviso.matches('^aviso_[a-f0-9-]{36}$')
              && d.autor_uid == request.auth.uid && d.dia in ['Lu','Ma','Mi','Ju','Vi']
              && a.keys().hasAll(['id','materia','tipo','detalle','fecha'])
              && a.keys().hasOnly(['id','materia','tipo','detalle','fecha'])
              && aviso == 'aviso_' + a.id
              && a.materia is string && a.materia.size() > 0 && a.materia.size() <= 100
              && a.tipo in ['tarea','evaluacion']
              && a.detalle is string && a.detalle.size() >= 3 && a.detalle.size() <= 1000
              && a.fecha is string
              && (a.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                || (a.tipo == 'tarea' && a.fecha == ''));
          }
          // Archivar no permite modificar contenido, autor, curso ni origen.
          function archivadoValido() {
            let d = request.resource.data;
            return resource.data.archivado == false && d.archivado == true
              && d.archivado_por == request.auth.uid && d.archivado_en == request.time
              && d.diff(resource.data).affectedKeys()
                .hasOnly(['archivado','archivado_por','archivado_en']);
          }
          allow read: if true;
          allow create: if esDelegado(curso,int(ciclo)) && baseValida()
            && nuevoValido();
          allow update: if esDelegado(curso,int(ciclo)) && archivadoValido();
          allow delete: if false;
        }
      }
    }
    // Solo lectura durante el traslado. La app ya no crea documentos por día.
    match /avisos_semana/{dia} {
      allow read: if true;
      allow write: if false;
    }
    match /ideas_app/{id} {
      allow create: if request.resource.data.keys().hasAll(['idea','curso','creada_en','estado'])
        && request.resource.data.keys().hasOnly(['idea','curso','creada_en','estado'])
        && request.resource.data.idea is string
        && request.resource.data.idea.size() >= 10 && request.resource.data.idea.size() <= 1000
        && request.resource.data.curso is string && request.resource.data.curso.size() <= 50
        && request.resource.data.creada_en is timestamp && request.resource.data.estado == 'nueva';
      allow read, update, delete: if false;
    }
    match /instalaciones_app/{id} {
      function valida() {
        return request.resource.data.keys().hasAll(['instalada_en','ultima_actividad','curso','version','compilacion','plataforma'])
          && request.resource.data.keys().hasOnly(['instalada_en','ultima_actividad','curso','version','compilacion','plataforma'])
          && id.matches('^[0-9a-f-]{36}$')
          && request.resource.data.instalada_en is timestamp
          && request.resource.data.ultima_actividad == request.time
          && request.resource.data.curso is string && request.resource.data.curso.size() <= 50
          && request.resource.data.version is string && request.resource.data.version.size() <= 30
          && request.resource.data.compilacion is string && request.resource.data.compilacion.size() <= 30
          && request.resource.data.plataforma == 'android';
      }
      allow create: if valida();
      allow update: if valida() && request.resource.data.instalada_en == resource.data.instalada_en;
      allow read, delete: if false;
    }
    // Conservar el namespace de NEXUS tal como estaba publicado.
    match /nexus_users/{uid}/state/{document} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && document == 'current'
        && request.resource.data.keys().hasOnly([
          'tasks','evaluations','projects','sessions','schemaVersion','updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.tasks is map
        && request.resource.data.evaluations is map
        && request.resource.data.projects is map
        && request.resource.data.sessions is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Compatibilidad con namespaces ajenos a A&P que ya estaban habilitados.
    // Excluir expresamente los protegidos para que esta regla no los vuelva públicos.
    match /{collection}/{document=**} {
      allow read, write: if !(collection in [
        'usuarios','ciclos','avisos_semana','ideas_app','instalaciones_app','nexus_users'
      ]) && !collection.matches('^_.*');
    }
    match /{document=**} { allow read, write: if false; }
  }
}
